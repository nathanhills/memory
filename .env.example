# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App URL (local or production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Same Google OAuth client credentials configured in Supabase Auth > Google
# Required to refresh provider tokens server-side
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cron protection (set the same value in Vercel Cron Authorization header)
CRON_SECRET=generate-a-long-random-string

# Optional: email digests via Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=Memory <onboarding@resend.dev>
